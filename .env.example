# Used by api/invite-employee.ts (Vercel serverless function). Set these in
# Vercel's project environment variables — SUPABASE_SERVICE_ROLE_KEY must
# NEVER be exposed to the browser/frontend, only to this server-side function.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

{
  // Type-check only (tests are type-checked by vitest). Node runs these files directly by stripping the types
  // (no build step), so only erasable TypeScript syntax is allowed.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"], "exclude": ["*.test.ts"]
}

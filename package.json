{
  "name": "accelerate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API server for the Accelerate training platform: serves web/dist, verifies Microsoft sign-in, and forwards database requests to PostgREST.",
  "scripts": {
    "start": "node server/index.ts",
    "migrate": "node server/migrate.js",
    "test": "vitest run db",
    "typecheck": "tsc -p server"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

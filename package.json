{
  "name": "accelerate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API server for the Accelerate training platform: serves web/dist, verifies Microsoft sign-in, and forwards database requests to PostgREST.",
  "scripts": {
    "start": "node --import @azure/monitor-opentelemetry/loader --import ./server/telemetry.ts server/index.ts",
    "migrate": "node server/migrate.js",
    "test": "vitest run db worker",
    "typecheck": "tsc -p server && tsc -p worker",
    "worker": "node --import @azure/monitor-opentelemetry/loader --import ./server/telemetry.ts worker/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.12.0",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@azure/storage-blob": "^12.34.0",
    "@opentelemetry/api": "^1.9.1",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
